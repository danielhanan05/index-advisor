# Optional advanced/developer override.
# End users do NOT need to set this manually. If it is missing, the backend
# starts in frontend setup mode. The user enters DB details in the setup page,
# and the app creates/connects to storage_db on that same PostgreSQL host.
# After successful setup, the backend writes encrypted storage.env in the local
# user config directory so the product remembers storage_db after restart.
# The OS environment variable STORAGE_DATABASE_URL still overrides that file.
# STORAGE_DATABASE_URL=postgresql://user:password@host:5432/storage_db

# Optional names used by first-time setup when STORAGE_DATABASE_URL is not set.
STORAGE_DATABASE_NAME=storage_db
STORAGE_MAINTENANCE_DB=postgres

# Product settings defaults. End users can edit these from the Settings page after setup.
# Old collection runs and dependent metadata/recommendations are deleted after this many days.
STORAGE_RETENTION_DAYS=30

# Automatic collect + analyze scheduler defaults. Uses the backend server local time.
# Manual runs still work. By default it runs twice daily: 06:00 and 20:00.
SCHEDULER_ENABLED=true
SCHEDULER_RUN_TIMES=06:00,20:00

# PostgreSQL connection timeout for target/storage connection attempts, in seconds.
# Prevents setup/test/analyze requests from hanging when PostgreSQL is down or unreachable.
DATABASE_CONNECT_TIMEOUT_SECONDS=15

# Optional dev fallback target.
# In product mode, add database targets from the UI instead.
# TARGET_DATABASE_URL=postgresql://user:password@host:5432/target_db

TOP_QUERY_LIMIT=50
ANALYZE_QUERY_LIMIT=25

MIN_COST_IMPROVEMENT_PCT=20
MIN_RECOMMENDATION_IMPROVEMENT_PCT=10
MAX_WRITE_RATIO_FOR_INDEX=0.4

# Development only. Production/package mode serves React from FastAPI on the same origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO

# Local admin auth. The backend generates admin_token.env in the local config directory automatically.
# Scripts can send X-Index-Advisor-Token with this value for dangerous endpoints.
# INDEX_ADVISOR_ADMIN_TOKEN is intentionally not required for normal users.

# Optional credential encryption key override. Normally generated as credential.key in the local config directory.
# INDEX_ADVISOR_CREDENTIAL_KEY=

# Optional development override. Use this if you want runtime files under ./config
# while developing instead of %APPDATA%/IndexAdvisor or ~/.config/index-advisor.
# INDEX_ADVISOR_CONFIG_DIR=./config

# Production/local launcher options used by run_app.py.
# INDEX_ADVISOR_HOST=127.0.0.1
# INDEX_ADVISOR_PORT=8000
# INDEX_ADVISOR_NO_BROWSER=false
